{
  "name": "dreampia-dev",
  "version": "1.6.5",
  "description": "Open source desktop AI coding wrapper. Claude Code + OpenAI Codex 통합 GUI.",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "license": "Apache-2.0",
  "author": {
    "name": "Dreampia",
    "email": "low@eonofpixel.com"
  },
  "homepage": "https://github.com/eonofpixel/dreampia-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/eonofpixel/dreampia-dev.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps || node -e \"console.warn('[postinstall] electron-builder install-app-deps failed; run npm run dev:rebuild manually if needed')\"",
    "predev": "node scripts/ensure-abi.cjs electron",
    "dev": "vite",
    "dev:rebuild": "electron-rebuild -f -w better-sqlite3",
    "build": "tsc --noEmit && vite build && electron-builder",
    "build:dir": "vite build && electron-builder --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-abi.cjs node",
    "test": "vitest run",
    "test:rebuild": "npm rebuild better-sqlite3 --build-from-source",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "pretest:e2e": "vite build && node scripts/ensure-abi.cjs electron",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "diagnose": "node scripts/dreampia-diagnose.cjs",
    "icons:generate": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^2.1.0"
  }
}
