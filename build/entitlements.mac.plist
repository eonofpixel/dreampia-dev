<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- JIT for V8 engine (required for Electron) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Unsigned executable memory (Electron framework) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- DYLD environment variables -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- File access (user-initiated only — no full disk) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Network for AI API + CLI subprocess + browser view -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Subprocess execution (claude/codex CLI) -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
